# ==========================================
# LLM & AI Model Settings (Agent Layer)
# ==========================================
OPENAI_API_KEY=your-openai-api-key-here
OPENAI_MODEL=gpt-4o-mini
DECISIONS_MODEL=gpt-6-luna
# Evidence judge adapter: decisions_api | structured_output | rule_based | auto
EVIDENCE_JUDGE_MODE=decisions_api
EVIDENCE_JUDGE_MODEL=

# ==========================================
# Observability: LangSmith Tracing (Opt-in)
# ==========================================
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=incident-ops-agent
LANGSMITH_ENDPOINT=https://api.smith.langchain.com

# ==========================================
# Gateway & Network (Caddy & Docker)
# ==========================================
CADDY_HTTP_PORT=80
CADDY_DOMAIN=:80
# Set a private token shared by the backend and its internal clients.
INTERNAL_SERVICE_TOKEN=
# Optional read-only credential for the log analyzer (must differ from INTERNAL_SERVICE_TOKEN).
# When set, the backend treats it as read-only and the log analyzer receives only this token.
INTERNAL_INVESTIGATOR_TOKEN=
CORS_ALLOWED_ORIGINS=["http://localhost","http://localhost:3000"]

# ==========================================
# Infrastructure: MySQL 8.0 & Redis
# ==========================================
MYSQL_HOST=mysql
MYSQL_PORT=3306
MYSQL_DATABASE=incident_ops
MYSQL_USER=ops_user
MYSQL_PASSWORD=ops_password_1234
MYSQL_ROOT_PASSWORD=root_password_1234

REDIS_HOST=redis
REDIS_URL=redis://redis:6379/0

# ==========================================
# Backend: Spring Boot (Domain API & MCP Server)
# ==========================================
# Use docker,demo to load sample data.
SPRING_PROFILES_ACTIVE=docker
BACKEND_PORT=8080
SPRING_DATASOURCE_URL=jdbc:mysql://mysql:3306/incident_ops?useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=Asia/Seoul&characterEncoding=UTF-8
SPRING_DATASOURCE_USERNAME=ops_user
SPRING_DATASOURCE_PASSWORD=ops_password_1234

# ==========================================
# Agent: Python FastAPI
# ==========================================
SUPERVISOR_PORT=8000
LOG_AGENT_PORT=8001
REMEDIATION_AGENT_PORT=8002

# A2A Sub-Agent Endpoints
LOG_AGENT_A2A_URL=http://log-analyzer-agent:8001
REMEDIATION_AGENT_A2A_URL=http://remediation-agent:8002

# MCP Server Endpoint
SPRING_MCP_SSE_URL=http://backend:8080/sse

# DR-DCI Tuning
DR_DCI_MODE=keyword
DR_DCI_SELECTOR_MODE=adaptive
DR_DCI_MAX_CHUNK_CHARS=4000
DR_DCI_MAX_PULL_STEPS=5
DR_DCI_MAX_CONTEXT_CHARS=6000

# External Tools & Calendar Adapter (Remediation Agent)
DEFAULT_SERVICE_NAME=payment-service
EXTERNAL_SERVICE_MAP_JSON=
GITHUB_TOKEN=
GITHUB_REPO=
GITHUB_ENVIRONMENT=production
GRAFANA_PROMETHEUS_URL=
GRAFANA_INSTANCE_ID=
GRAFANA_METRICS_TOKEN=
GOOGLE_CALENDAR_ID=
GOOGLE_CALENDAR_TOKEN=
CALENDAR_ADAPTER_MODE=google
LOCAL_FREEZE_CALENDAR_PATH=

# ==========================================
# Frontend: Next.js + AG-UI Client
# ==========================================
FRONTEND_PORT=3000
NEXT_PUBLIC_GATEWAY_URL=http://localhost
NEXT_PUBLIC_AG_UI_PATH=/api/ag-ui
NEXT_PUBLIC_INCIDENT_API_PATH=/api/incidents
