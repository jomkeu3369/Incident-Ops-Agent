# 실스택 검증용 환경 파일 예시. 복사해 저장소 밖에 두고 토큰 두 값을 서로 다른 임의 문자열로 채운다.
INTERNAL_SERVICE_TOKEN=
INTERNAL_INVESTIGATOR_TOKEN=
SPRING_PROFILES_ACTIVE=docker,demo
OPENAI_API_KEY=
EVIDENCE_JUDGE_MODE=rule_based
LANGSMITH_TRACING=false
CALENDAR_ADAPTER_MODE=local
GITHUB_REPO=demo/payment-service
GITHUB_TOKEN=fake-github-token
GRAFANA_PROMETHEUS_URL=http://fake-external:9000/prom
GRAFANA_METRICS_TOKEN=fake-metrics-token
SPRING_DATASOURCE_URL=jdbc:mysql://mysql:3306/incident_ops?useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=Asia/Seoul&characterEncoding=UTF-8
SPRING_DATASOURCE_USERNAME=ops_user
SPRING_DATASOURCE_PASSWORD=ops_password_1234
